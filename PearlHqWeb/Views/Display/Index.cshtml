@model DisplayViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="15" />
    <title>Pearl HQ</title>
    <style>
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            background: #101418;
            color: #f2f2f2;
            font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
        }
        .columns {
            display: flex;
            width: 100%;
            height: 100%;
        }
        .column {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3vh 3vw;
            gap: 2vh;
            height: 100%;
            overflow-y: auto;
        }
        .column + .column {
            border-left: 2px solid #2a2f36;
        }
        .column-title {
            font-size: 4vh;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #9aa4af;
        }
        .card {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5vh;
            flex-shrink: 0;
        }
        .dish-name {
            font-size: 2.5vh;
            color: #9aa4af;
        }
        .gauge-track {
            width: 22vw;
            height: 42vh;
            border-radius: 1.5vw;
            background: #1c2128;
            border: 3px solid #2a2f36;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
            flex-shrink: 0;
        }
        .gauge-fill {
            width: 100%;
            transition: height 0.4s ease;
        }
        .gauge-fill.ok { background: linear-gradient(#3fb950, #2ea043); }
        .gauge-fill.low { background: linear-gradient(#f85149, #da3633); }
        .gauge-fill.unknown { background: #3a3f47; }
        .percent {
            font-size: 6vh;
            font-weight: 700;
        }
        .weight {
            font-size: 2.2vh;
            color: #9aa4af;
        }
        .badge {
            font-size: 2.5vh;
            font-weight: 600;
            padding: 0.6vh 2vw;
            border-radius: 999px;
        }
        .badge.ok { background: #23422c; color: #4ade80; }
        .badge.low { background: #4a2323; color: #f87171; }
        .badge.unknown { background: #2a2f36; color: #9aa4af; }
        .alert {
            font-size: 2.8vh;
            font-weight: 600;
            color: #f87171;
            text-align: center;
        }
        .empty {
            font-size: 2.5vh;
            color: #6b7280;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="columns">
        <div class="column">
            <div class="column-title">Food</div>
@if (!Model.FoodDishes.Any()) {
            <div class="empty">No food dish configured</div>
}
@foreach (var (dish, status) in Model.FoodDishes) {
            @await Html.PartialAsync("_DishGauge", (dish, status))
}
        </div>
        <div class="column">
            <div class="column-title">Water</div>
@if (!Model.WaterDishes.Any()) {
            <div class="empty">No water dish configured</div>
}
@foreach (var (dish, status) in Model.WaterDishes) {
            @await Html.PartialAsync("_DishGauge", (dish, status))
}
        </div>
    </div>
</body>
</html>
