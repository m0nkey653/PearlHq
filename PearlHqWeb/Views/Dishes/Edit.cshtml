@model Dish

@{
    ViewData["Title"] = "Edit dish";
}

<h1>Edit dish</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Type" class="control-label"></label>
        <select asp-for="Type" class="form-control" asp-items="Html.GetEnumSelectList<DishType>()"></select>
    </div>
    <div class="form-group mb-3">
        <label asp-for="DeviceId" class="control-label">Device</label>
        <select asp-for="DeviceId" class="form-control" asp-items="ViewBag.DeviceId"></select>
    </div>
    <div class="form-group mb-3">
        <label class="control-label">Empty (tare) weight (g)</label>
        <input value="@Model.EmptyWeightGrams" class="form-control" readonly disabled />
        <span class="text-muted">Set by the device when it tares — not editable here.</span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="LowThresholdGrams" class="control-label">Low threshold (g)</label>
        <input asp-for="LowThresholdGrams" class="form-control" />
        <span asp-validation-for="LowThresholdGrams" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label class="control-label">Target full weight (g)</label>
        <input value="@Model.TargetFullWeightGrams" class="form-control" readonly disabled />
        <span class="text-muted">Set by the device's full button — not editable here.</span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</form>
