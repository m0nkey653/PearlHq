@model Dish

@{
    ViewData["Title"] = "Add dish";
}

<h1>Add dish</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Type" class="control-label"></label>
        <select asp-for="Type" class="form-control" asp-items="Html.GetEnumSelectList<DishType>()"></select>
    </div>
    <div class="form-group mb-3">
        <label asp-for="DeviceId" class="control-label">Device</label>
        <select asp-for="DeviceId" class="form-control" asp-items="ViewBag.DeviceId"></select>
    </div>
    <div class="form-group mb-3">
        <label asp-for="LowThresholdGrams" class="control-label">Low threshold (g)</label>
        <input asp-for="LowThresholdGrams" class="form-control" />
        <span asp-validation-for="LowThresholdGrams" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="TargetFullWeightGrams" class="control-label">Target full weight (g)</label>
        <input asp-for="TargetFullWeightGrams" class="form-control" />
        <span asp-validation-for="TargetFullWeightGrams" class="text-danger"></span>
    </div>
    <p class="text-muted">Empty (tare) weight isn't set here — it's reported by the device the first time it tares.</p>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</form>
