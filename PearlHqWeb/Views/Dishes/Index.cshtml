@model IEnumerable<Dish>

@{
    ViewData["Title"] = "Dishes";
}

<h1>Dishes</h1>

<p><a asp-action="Create" class="btn btn-primary">Add dish</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Device</th>
            <th>Empty weight (g)</th>
            <th>Low threshold (g)</th>
            <th>Target full weight (g)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.Type</td>
            <td>@item.Device.Name</td>
            <td>@item.EmptyWeightGrams</td>
            <td>@item.LowThresholdGrams</td>
            <td>@item.TargetFullWeightGrams</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
