# Copy this file to .env and fill in real values. .env is gitignored.

# InfluxDB initial setup (only used the first time the influxdb volume is created)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=changeme
DOCKER_INFLUXDB_INIT_ORG=pearlhq
DOCKER_INFLUXDB_INIT_BUCKET=scale-readings
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=changeme-generate-a-real-token

# Passed into the web container so it can talk to InfluxDB
Influx__Token=changeme-generate-a-real-token
Influx__Org=pearlhq
Influx__Bucket=scale-readings

# Shared secret the ESP32 devices send in the X-Api-Key header when posting readings
Ingest__ApiKey=changeme-shared-secret
